rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    // Membership is provisioned in Firebase Console, never by the web app.
    function admin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    function natural(n, max) { return n is int && n >= 0 && n <= max; }
    // US Central daylight saving begins at 08:00 UTC on March's second Sunday
    // and ends at 07:00 UTC on November's first Sunday. Noon itself is unambiguous.
    function centralDay(at) {
      let year = at.year();
      let marchSunday = 1 + (7 - timestamp.date(year, 3, 1).dayOfWeek()) % 7 + 7;
      let novemberSunday = 1 + (7 - timestamp.date(year, 11, 1).dayOfWeek()) % 7;
      let start = timestamp.date(year, 3, marchSunday) + duration.value(8, 'h');
      let end = timestamp.date(year, 11, novemberSunday) + duration.value(7, 'h');
      let noonHour = at >= start && at < end ? 17 : 18;
      return int((at.toMillis() - noonHour * 3600000) / 86400000);
    }
    function game(id) {
      let d = request.resource.data;
      return d.keys().hasAll(['version','id','mode','startedAt','updatedAt','outcome','guesses','correct','answered','bestStreak','stage','recordedAt'])
        && d.keys().hasOnly(['version','id','mode','startedAt','updatedAt','outcome','guesses','correct','answered','bestStreak','stage','recordedAt','cluesShown','hintUsed','shortestCrossings'])
        && d.version == 1 && id.matches('^[a-zA-Z0-9_-]{8,100}$') && d.id == id
        && d.mode in ['countries','capitals','flags','shapes','journey','trivia','mystery','who','identify','adventure','daily']
        && d.outcome in ['active','won','revealed','lost','completed','abandoned']
        && d.startedAt is int && d.updatedAt is int && d.startedAt >= 946684800000
        && d.updatedAt >= d.startedAt && d.updatedAt <= request.time.toMillis() + 300000
        && natural(d.guesses,10000) && natural(d.answered,10000)
        && natural(d.correct,d.answered) && natural(d.bestStreak,d.correct) && natural(d.stage,13)
        && (!('cluesShown' in d) || (d.mode in ['mystery','who','identify'] && natural(d.cluesShown,d.mode == 'identify' ? 2 : 5) && d.cluesShown >= 1))
        && (!('hintUsed' in d) || (d.mode in ['flags','shapes'] && d.hintUsed is bool))
        && (!('shortestCrossings' in d) || (d.mode == 'journey' && natural(d.shortestCrossings,194) && d.shortestCrossings >= 1 && (d.outcome != 'won' || d.guesses >= d.shortestCrossings)))
        && d.recordedAt == request.time;
    }
    match /users/{uid}/games/{id} {
      allow read: if owner(uid) || admin();
      allow create: if owner(uid) && game(id);
      allow update: if owner(uid) && game(id)
        && request.resource.data.mode == resource.data.mode
        && request.resource.data.startedAt <= resource.data.startedAt
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && request.resource.data.guesses >= resource.data.guesses
        && request.resource.data.answered >= resource.data.answered
        && request.resource.data.correct >= resource.data.correct
        && request.resource.data.bestStreak >= resource.data.bestStreak
        && request.resource.data.stage >= resource.data.stage
        && (!('cluesShown' in resource.data) || ('cluesShown' in request.resource.data && request.resource.data.cluesShown >= resource.data.cluesShown))
        && (!('hintUsed' in resource.data) || ('hintUsed' in request.resource.data && (!resource.data.hintUsed || request.resource.data.hintUsed)))
        && (!('shortestCrossings' in resource.data) || ('shortestCrossings' in request.resource.data && request.resource.data.shortestCrossings == resource.data.shortestCrossings))
        && (resource.data.outcome == 'active' || request.resource.data.outcome != 'active');
    }
    match /users/{uid}/checkins/{id} {
      allow read: if owner(uid) || admin();
      allow create: if owner(uid)
        && request.resource.data.keys().hasAll(['day','at','recordedAt'])
        && request.resource.data.keys().hasOnly(['day','at','recordedAt'])
        && request.resource.data.day is int && id == string(request.resource.data.day)
        && request.resource.data.at is int && request.resource.data.at >= 946684800000
        && request.resource.data.at <= request.time.toMillis() + 300000
        && request.resource.data.day == centralDay(timestamp.value(request.resource.data.at))
        && request.resource.data.day <= centralDay(request.time)
        && request.resource.data.recordedAt == request.time;
      allow create: if admin() && creditedCheckIn(uid, id);
      // A day is immutable. Offline/guest history may be imported, but no future day may be claimed.
    }
    function creditedCheckIn(uid, id) {
      let d = request.resource.data;
      let path = /databases/$(database)/documents/adminAudit/$(d.creditId);
      let entry = getAfter(path).data;
      return d.keys().hasAll(['day','at','recordedAt','creditId'])
        && d.keys().hasOnly(['day','at','recordedAt','creditId'])
        && d.creditId is string && d.creditId.size() == 20
        && d.day is int && id == string(d.day)
        && d.at is int && d.at >= 946684800000
        && d.at <= request.time.toMillis() + 300000
        && d.day == centralDay(timestamp.value(d.at))
        && d.day <= centralDay(request.time) && d.recordedAt == request.time
        && !exists(path)
        && entry.actorUid == request.auth.uid && entry.targetUid == uid
        && d.day <= entry.anchorDay && d.day >= entry.anchorDay - entry.requestedCurrent + 1
        && entry.createdAt == request.time && d.day in entry.creditedDays;
    }
    match /admins/{uid} {
      allow get: if owner(uid);
      // No client, including an admin, may grant or modify admin access.
    }
    match /players/{uid} {
      allow get: if owner(uid) || admin();
      allow list: if admin() && request.query.limit != null && request.query.limit <= 20;
      allow create, update: if owner(uid)
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasAll(['uid','displayName','email','emailLower','updatedAt'])
        && request.resource.data.keys().hasOnly(['uid','displayName','email','emailLower','updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailLower == request.auth.token.email.lower()
        && request.resource.data.updatedAt == request.time;
    }
    match /adminAudit/{id} {
      allow get: if admin();
      allow list: if admin() && request.query.limit != null && request.query.limit <= 25;
      allow create: if admin()
        && id.size() == 20
        && request.resource.data.keys().hasAll(['version','actorUid','targetUid','previousCurrent','requestedCurrent','anchorDay','creditedDays','reason','createdAt'])
        && request.resource.data.keys().hasOnly(['version','actorUid','targetUid','previousCurrent','requestedCurrent','anchorDay','creditedDays','reason','createdAt'])
        && request.resource.data.version == 1 && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.targetUid is string && request.resource.data.targetUid.size() > 0 && request.resource.data.targetUid.size() <= 128
        && natural(request.resource.data.previousCurrent,364)
        && natural(request.resource.data.requestedCurrent,365)
        && request.resource.data.requestedCurrent > request.resource.data.previousCurrent
        && request.resource.data.anchorDay is int
        && request.resource.data.anchorDay >= centralDay(request.time) - 1
        && request.resource.data.anchorDay <= centralDay(request.time)
        && request.resource.data.creditedDays is list
        && request.resource.data.creditedDays.size() > 0 && request.resource.data.creditedDays.size() <= 365
        && request.resource.data.creditedDays.toSet().size() == request.resource.data.creditedDays.size()
        && request.resource.data.reason is string && request.resource.data.reason.size() >= 3 && request.resource.data.reason.size() <= 240
        && request.resource.data.createdAt == request.time;
      // Audit entries cannot be edited or deleted, including by admins.
    }
    function dailyMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/dailyMembers/$(request.auth.uid))
        && get(/databases/$(database)/documents/dailyMembers/$(request.auth.uid)).data.enabled == true;
    }
    function dailyAccess() { return admin() || dailyMember(); }
    match /dailyMembers/{uid} {
      allow get: if owner(uid) || dailyAccess();
      allow list: if dailyAccess() && request.query.limit != null && request.query.limit <= 20;
      allow create, update: if admin()
        && request.resource.data.keys().hasAll(['version','uid','displayName','enabled','addedBy','updatedAt'])
        && request.resource.data.keys().hasOnly(['version','uid','displayName','enabled','addedBy','updatedAt'])
        && request.resource.data.version == 1 && request.resource.data.uid == uid
        && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 80
        && request.resource.data.enabled is bool && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }
    function dailyResult(uid, day) {
      let d = request.resource.data;
      return owner(uid) && dailyAccess()
        && d.keys().hasAll(['version','uid','day','challengeVersion','status','attempted','solved','score','updatedAt','completedAt'])
        && d.keys().hasOnly(['version','uid','day','challengeVersion','status','attempted','solved','score','updatedAt','completedAt'])
        && d.version == 1 && d.uid == uid && d.challengeVersion == 1
        && d.day is int && string(d.day) == day && d.day == centralDay(request.time)
        && d.status in ['started','finished'] && natural(d.attempted,5) && natural(d.solved,d.attempted)
        && natural(d.score,500) && d.score <= d.solved*100 && d.score >= d.solved*90
        && ((d.status == 'finished' && d.attempted == 5 && d.completedAt == request.time)
          || (d.status == 'started' && d.attempted < 5 && d.completedAt == null))
        && d.updatedAt == request.time;
    }
    match /dailyResults/{day}/entries/{uid} {
      allow get: if dailyAccess();
      allow list: if dailyAccess() && request.query.limit != null && request.query.limit <= 20;
      allow create: if dailyResult(uid,day);
      allow update: if dailyResult(uid,day) && resource.data.status != 'finished'
        && request.resource.data.day == resource.data.day
        && request.resource.data.challengeVersion == resource.data.challengeVersion
        && request.resource.data.attempted >= resource.data.attempted
        && request.resource.data.solved >= resource.data.solved
        && request.resource.data.score >= resource.data.score;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
